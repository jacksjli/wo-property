{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "YARP": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "ticket": {
        "ClusterId": "ticket-service",
        "Match": {
          "Path": "/api/tickets/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/tickets/{**remainder}"
          }
        ]
      },
      "dispatch": {
        "ClusterId": "dispatch-service",
        "Match": {
          "Path": "/api/dispatch/{**catch-all}"
        }
      },
      "notifications": {
        "ClusterId": "notification-service",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "persons": {
