        }
      },
      "master-data": {
        "ClusterId": "master-data-service",
        "Match": {
          "Path": "/api/master-data/{**catch-all}"
        }
      },
      "statistics": {
        "ClusterId": "statistics-service",
        "Match": {
          "Path": "/api/statistics/{**catch-all}"
        }
      },
      "auth": {
        "ClusterId": "auth-service",
