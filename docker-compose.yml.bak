version: '3.8'

services:
  # 数据库服务
  postgres:
    image: postgres:16-alpine
    container_name: wo-property-postgres
    environment:
      POSTGRES_DB: wo_property
      POSTGRES_USER: woproperty
      POSTGRES_PASSWORD: WOProperty2026!
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U woproperty"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Redis缓存
  redis:
    image: redis:7-alpine
    container_name: wo-property-redis
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Nginx反向代理
  nginx:
    image: nginx:alpine
    container_name: wo-property-nginx
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./docker/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./docker/ssl:/etc/nginx/ssl:ro
      - nginx_logs:/var/log/nginx
    depends_on:
      auth-service:
        condition: service_healthy
      material-service:
        condition: service_healthy
      notification-service:
        condition: service_healthy
      contract-service:
        condition: service_healthy
      finance-service:
        condition: service_healthy
      inspection-service:
        condition: service_healthy
      complaint-service:
        condition: service_healthy
      key-service:
        condition: service_healthy
      visitor-service:
        condition: service_healthy
      statistics-service:
        condition: service_healthy
      mobile-service:
        condition: service_healthy
      ticket-type-service:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # ============ 微服务 ============

  # 认证服务
  auth-service:
    build:
      context: ./src/WO.Property.AuthService
      dockerfile: Dockerfile
    container_name: wo-auth-service
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - DB_CONNECTION_STRING=Host=postgres;Database=wo_property;Username=woproperty;Password=WOProperty2026!
      - JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
      - JWT_ISSUER=wo-property-unified-auth
      - JWT_AUDIENCE=wo-property-services
    ports:
      - "5006:5006"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5006/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # 物料管理服务
  material-service:
    build:
      context: ./src/WO.Property.MaterialService
      dockerfile: Dockerfile
    container_name: wo-material-service
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - DB_CONNECTION_STRING=Host=postgres;Database=wo_property;Username=woproperty;Password=WOProperty2026!
      - JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
    ports:
      - "5004:5004"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5004/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # 通知服务
  notification-service:
    build:
      context: ./src/WO.Property.NotificationService
      dockerfile: Dockerfile
    container_name: wo-notification-service
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - DB_CONNECTION_STRING=Host=postgres;Database=wo_property;Username=woproperty;Password=WOProperty2026!
      - JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
    ports:
      - "5005:5005"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5005/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # 合同服务
  contract-service:
    build:
      context: ./src/WO.Property.ContractService
      dockerfile: Dockerfile
    container_name: wo-contract-service
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - DB_CONNECTION_STRING=Host=postgres;Database=wo_property;Username=woproperty;Password=WOProperty2026!
      - JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
    ports:
      - "5008:5008"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5008/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # 财务服务
  finance-service:
    build:
      context: ./src/WO.Property.FinanceService
      dockerfile: Dockerfile
    container_name: wo-finance-service
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - DB_CONNECTION_STRING=Host=postgres;Database=wo_property;Username=woproperty;Password=WOProperty2026!
      - JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
    ports:
      - "5009:5009"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5009/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # 巡检服务
  inspection-service:
    build:
      context: ./src/WO.Property.InspectionService
      dockerfile: Dockerfile
    container_name: wo-inspection-service
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - DB_CONNECTION_STRING=Host=postgres;Database=wo_property;Username=woproperty;Password=WOProperty2026!
      - JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
    ports:
      - "5010:5010"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5010/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # 投诉服务
  complaint-service:
    build:
      context: ./src/WO.Property.ComplaintService
      dockerfile: Dockerfile
    container_name: wo-complaint-service
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - DB_CONNECTION_STRING=Host=postgres;Database=wo_property;Username=woproperty;Password=WOProperty2026!
      - JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
    ports:
      - "5011:5011"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5011/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # 钥匙服务
  key-service:
    build:
      context: ./src/WO.Property.KeyService
      dockerfile: Dockerfile
    container_name: wo-key-service
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - DB_CONNECTION_STRING=Host=postgres;Database=wo_property;Username=woproperty;Password=WOProperty2026!
      - JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
    ports:
      - "5012:5012"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5012/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # 访客服务
  visitor-service:
    build:
      context: ./src/WO.Property.VisitorService
      dockerfile: Dockerfile
    container_name: wo-visitor-service
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - DB_CONNECTION_STRING=Host=postgres;Database=wo_property;Username=woproperty;Password=WOProperty2026!
      - JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
    ports:
      - "5013:5013"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5013/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # 统计服务
  statistics-service:
    build:
      context: ./src/WO.Property.StatisticsService
      dockerfile: Dockerfile
    container_name: wo-statistics-service
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - DB_CONNECTION_STRING=Host=postgres;Database=wo_property;Username=woproperty;Password=WOProperty2026!
      - JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
    ports:
      - "5014:5014"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5014/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # 智能派单服务
  dispatch-service:
    build:
      context: ./src/WO.Property.DispatchService
      dockerfile: Dockerfile
    container_name: wo-dispatch-service
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - DB_CONNECTION_STRING=Host=postgres;Database=wo_property;Username=woproperty;Password=WOProperty2026!
      - JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
      - JWT_ISSUER=wo-property-unified-auth
      - JWT_AUDIENCE=wo-property-services
    ports:
      - "5003:5003"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5003/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
