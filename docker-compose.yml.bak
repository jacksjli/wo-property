  # 移动端服务
  mobile-service:
    build:
      context: ./src/WO.Property.MobileService
      dockerfile: Dockerfile
    container_name: wo-mobile-service
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - DB_CONNECTION_STRING=Host=postgres;Database=wo_property;Username=woproperty;Password=WOProperty2026!
      - JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
    ports:
      - "5015:5015"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5015/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # 工单类型服务
  ticket-type-service:
    build:
      context: ./src/WO.Property.TicketTypeService
      dockerfile: Dockerfile
    container_name: wo-ticket-type-service
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - PORT=5029
      - JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
      - JWT_ISSUER=wo-property-unified-auth
      - JWT_AUDIENCE=wo-property-services
    ports:
      - "5029:5029"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5029/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

  # Vue前端
  frontend:
    build:
      context: ./src/admin-portal
      dockerfile: Dockerfile
    container_name: wo-frontend
    ports:
      - "3000:80"
    depends_on:
      nginx:
        condition: service_healthy
    networks:
      - wo-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:80/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

volumes:
  postgres_data:
  redis_data:
  nginx_logs:

networks:
  wo-network:
    driver: bridge
