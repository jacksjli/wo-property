# ============================================================
# WO-Property 环境变量模板
# 注意：本文件不含真实值，所有敏感信息通过 GitHub Secrets 或
#       生产服务器上的 docker-compose.yml 环境变量注入
# ============================================================

# ==================== 数据库 ====================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=wo_property
MYSQL_USER=woproperty
MYSQL_PASSWORD=WOProperty2026!      # ⚠️ 通过 secrets 注入，不要提交真实值
MYSQL_ROOT_PASSWORD=rootpassword    # ⚠️ 通过 secrets 注入

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=WO-Property-Management-Unified-Secret-Key-2026-For-All-Services
JWT_ISSUER=wo-property-unified-auth
JWT_AUDIENCE=wo-property-services
JWT_EXPIRATION_MINUTES=480

# ==================== 服务端口 ====================
GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5006
MASTERDATA_SERVICE_PORT=5019
PERSON_SERVICE_PORT=5018
TICKET_SERVICE_PORT=5002

# ==================== ASP.NET Core ====================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# ==================== 前端 / Nginx ====================
VITE_API_BASE_URL=http://nginx/api
NGINX_PORT=80
NGINX_SSL_PORT=443

# ==================== 生产服务器（部署用） ====================
# ⚠️ 通过 GitHub Secrets 注入
PROD_SERVER_HOST=your-production-server-ip-or-hostname
PROD_SERVER_USER=deploy
PROD_SERVER_PORT=22
TEST_SERVER_HOST=your-test-server-ip-or-hostname
TEST_SERVER_USER=deploy

# ==================== 镜像仓库 ====================
REGISTRY=ghcr.io
IMAGE_PREFIX=your-github-username/woproperty
# 示例: ghcr.io/your-username/woproperty/gateway:main-abc1234

# ==================== 钉钉 / 企微 Webhook ====================
# ⚠️ 通过 GitHub Secrets 注入
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ==================== SonarQube（可选） ====================
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=                     # ⚠️ 通过 secrets 注入

# ==================== 通知 / 监控 ====================
SLACK_WEBHOOK=
PAGERDUTY_KEY=
